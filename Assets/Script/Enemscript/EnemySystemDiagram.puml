@startuml Enemy_And_Upgrade_Architecture
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam Shadowing false

' ============================================================
' INTERFACES
' ============================================================
package "Contracts (Interfaces)" {
    interface IDamageable {
        + IsDead : bool {get}
        + RegisterHit(amount : int) : void
    }

    interface IAlertable {
        + ReceiveAlert(knownPlayerPos : Vector3) : void
    }
}

' ============================================================
' ENEMY STATISTICS & CORE COMPONENTS (COMPOSITION)
' ============================================================
package "Enemy Statistics & Core Components" {
    class EnemyStatsSO <<ScriptableObject>> {
        + baseMaxHp : int = 3
        + baseCoinReward : int = 5
        + baseMoveSpeed : float = 3.0f
        + baseRoamSpeed : float = 1.2f
        + baseDamage : int = 30
        + baseFireRate : float = 0.6f
        + baseBurstCount : int = 3
        + baseViewRadius : float = 8.0f
    }

    class EnemyStats <<MonoBehaviour>> {
        - baseStats : EnemyStatsSO
        + MaxHp : int {get; set}
        + CoinReward : int {get; set}
        + MoveSpeed : float {get; set}
        + RoamSpeed : float {get; set}
        + Damage : int {get; set}
        + FireRate : float {get; set}
        + BurstCount : int {get; set}
        + ViewRadius : float {get; set}
        + OnStatsRecalculated : event Action
        + InitializeFromBase() : void
    }

    class EnemyHealth <<MonoBehaviour>> {
        - stats : EnemyStats
        + CurrentHp : int {get}
        + IsDead : bool {get}
        + bloodSplatPrefab : GameObject
        + splatsPerHit : int = 3
        + splatRadius : float = 0.6f
        + OnDamaged : event Action<int>
        + OnDied : event Action
        + RegisterHit(amount : int) : void
        - Die() : void
    }

    class EnemyMovement <<MonoBehaviour>> {
        - aiPath : AIPath
        - seeker : Seeker
        - stats : EnemyStats
        + arrivalThreshold : float = 0.35f
        + stuckTimeout : float = 10.0f
        + stuckMoveThreshold : float = 0.15f
        + SetDestination(pos : Vector3) : void
        + SetSpeed(speed : float) : void
        + StopMoving() : void
        + HasArrived() : bool
        + CheckStuck() : bool
    }

    class EnemyFOV <<MonoBehaviour>> {
        + viewRadius : float = 8.0f
        + viewAngle : float = 15.0f
        + obstacleMask : LayerMask
        + showLaser : bool
        + IsInFireCone(targetPos : Vector3) : bool
        - UpdateVisuals() : void
        - BuildConeMesh() : void
    }
}

' ============================================================
' ENEMY INHERITANCE HIERARCHY
' ============================================================
package "Enemy Hierarchy (Inheritance)" {
    abstract class EnemyBase <<MonoBehaviour>> {
        + {static} Active : List<EnemyBase>
        + Stats : EnemyStats {get}
        + Health : EnemyHealth {get}
        + Movement : EnemyMovement {get}
        + TargetPlayer : Transform {get}
        # abilities : List<EnemyAbility>
        # appliedUpgrades : List<EnemyUpgrade>
        + IsDead : bool {get}
        # virtual Awake() : void
        # virtual Start() : void
        # virtual Update() : void
        + virtual RegisterHit(amount : int) : void
        + ApplyUpgrade(upgrade : EnemyUpgrade) : void
        + GetAbility<T>() : T
        # abstract EvaluateAIState() : void
    }

    class Enemy_Range <<MonoBehaviour>> {
        - currentState : RangedState
        - rBurstAbility : RangedBurstAbility
        - coverAbility : CoverPeekAbility
        - alertAbility : TeamAlertAbility
        - fov : EnemyFOV
        + ReceiveAlert(knownPlayerPos : Vector3) : void
        # override EvaluateAIState() : void
        - UpdateBodyRotation() : void
    }

    class Enemy_Close <<MonoBehaviour>> {
        - meleeAbility : MeleeAttackAbility
        - chaseRange : float = 12.0f
        # override EvaluateAIState() : void
    }

    class Enemy_EliteShielder <<MonoBehaviour>> {
        - shieldAbility : RiotShieldAbility
        - rBurstAbility : RangedBurstAbility
        # override EvaluateAIState() : void
    }
}

' ============================================================
' ENEMY ABILITIES HIERARCHY (INHERITANCE + COMPOSITION)
' ============================================================
package "Enemy Abilities (Separated from Stats)" {
    abstract class EnemyAbility <<MonoBehaviour>> {
        # owner : EnemyBase
        # stats : EnemyStats
        + isAbilityEnabled : bool = true
        + cooldown : float
        # cooldownTimer : float
        + virtual Initialize(owner : EnemyBase) : void
        + virtual TickAbility(deltaTime : float) : void
        + abstract CanExecute() : bool
        + abstract Execute() : void
    }

    class RangedBurstAbility <<MonoBehaviour>> {
        + bulletPrefab : GameObject
        + firePos : Transform
        + obstacleMask : LayerMask
        - shotsFiredInBurst : int
        + override CanExecute() : bool
        + override Execute() : void
        + ShootAt(targetPos : Vector3) : void
        + HasClearShot(targetPos : Vector3) : bool
    }

    class CoverPeekAbility <<MonoBehaviour>> {
        - currentCover : CoverPoint
        + peekOffset : float = 1.2f
        + peekTimeout : float = 2.5f
        + coverWaitMin : float = 1.0f
        + coverWaitMax : float = 3.0f
        + ClaimNearestCover() : bool
        + ComputePeekPosition(targetPos : Vector3) : Vector3
        + ReleaseCover() : void
        + override CanExecute() : bool
        + override Execute() : void
    }

    class MeleeAttackAbility <<MonoBehaviour>> {
        + attackRadius : float = 1.0f
        + knockbackForce : float = 3.0f
        + override CanExecute() : bool
        + override Execute() : void
        - OnCollisionEnter2D(col : Collision2D) : void
    }

    class TeamAlertAbility <<MonoBehaviour>> {
        + alertBroadcastRadius : float = 15.0f
        + {static} TeamAlertTimer : float
        + BroadcastAlert(playerPos : Vector3) : void
        + override CanExecute() : bool
        + override Execute() : void
    }

    class RiotShieldAbility <<MonoBehaviour>> {
        + shieldCollider : Collider2D
        + shieldMaxDurability : int = 5
        + blocksRailgunOnce : bool = true
        + override CanExecute() : bool
        + override Execute() : void
    }

    class CoverPoint <<MonoBehaviour>> {
        + maxOccupants : int = 1
        + IsFull : bool {get}
        + Claim(enemy : EnemyBase) : void
        + Release(enemy : EnemyBase) : void
        + {static} FindBestCover(fromPos : Vector3, requester : EnemyBase) : CoverPoint
    }

    class EnemyBullet <<MonoBehaviour>> {
        + collisionMask : LayerMask
        + speed : float = 5.0f
        + damage : int = 30
        - FixedUpdate() : void
    }
}

' ============================================================
' UPGRADE SYSTEM HIERARCHY (INHERITANCE FOR UPGRADES)
' ============================================================
package "Upgrade Hierarchy (Class Inheritance)" {
    abstract class UpgradeBase <<ScriptableObject>> {
        + title : string
        + description : string
        + rarity : UpgradeRarity
        + weight : float = 10.0f
        + maxStacks : int = 0
        + abstract GetPreviewText() : string
    }

    ' --- Enemy Upgrades (Applied per Wave Set / Loop) ---
    abstract class EnemyUpgrade <<ScriptableObject>> {
        + tierLevel : int = 1
        + abstract ApplyToEnemy(enemy : EnemyBase) : void
        + virtual RemoveFromEnemy(enemy : EnemyBase) : void
    }

    class EnemyHealthUpgrade {
        + bonusHp : int = 3
        + hpMultiplier : float = 1.5f
        + override ApplyToEnemy(enemy : EnemyBase) : void
        + override GetPreviewText() : string
    }

    class EnemySpeedUpgrade {
        + speedBonus : float = 1.0f
        + roamSpeedBonus : float = 0.5f
        + override ApplyToEnemy(enemy : EnemyBase) : void
        + override GetPreviewText() : string
    }

    class EnemyBurstFireUpgrade {
        + extraBurstShots : int = 2
        + fireRateMultiplier : float = 0.8f
        + override ApplyToEnemy(enemy : EnemyBase) : void
        + override GetPreviewText() : string
    }

    class EnemyShieldUpgrade {
        + shieldPrefab : GameObject
        + bonusShieldDurability : int = 3
        + override ApplyToEnemy(enemy : EnemyBase) : void
        + override GetPreviewText() : string
    }

    ' --- Player Upgrades (In-Run Wave Card Upgrades) ---
    abstract class PlayerUpgrade <<ScriptableObject>> {
        + abstract ApplyToPlayer(pm : PlayerManagement) : void
    }

    class Upg_dmg {
        + bonusDamage : int = 1
        + override ApplyToPlayer(pm : PlayerManagement) : void
        + override GetPreviewText() : string
    }

    class Upg_ricochet {
        + extraBounces : int = 1
        + override ApplyToPlayer(pm : PlayerManagement) : void
        + override GetPreviewText() : string
    }

    class FireRateUpgrade {
        + intervalMultiplier : float = 0.85f
        + override ApplyToPlayer(pm : PlayerManagement) : void
        + override GetPreviewText() : string
    }

    class WalkSpeedUpgrade {
        + speedBonus : float = 0.5f
        + override ApplyToPlayer(pm : PlayerManagement) : void
        + override GetPreviewText() : string
    }

    class MagazineCapacityUpgrade {
        + extraBullets : int = 2
        + override ApplyToPlayer(pm : PlayerManagement) : void
        + override GetPreviewText() : string
    }

    class HomingRicochetUpgrade {
        + searchRadius : float = 15.0f
        + override ApplyToPlayer(pm : PlayerManagement) : void
        + override GetPreviewText() : string
    }

    class UpgradeManager <<MonoBehaviour>> {
        + {static} Instance : UpgradeManager
        + pool : List<PlayerUpgrade>
        - stacks : Dictionary<PlayerUpgrade, int>
        + ShowChoices(clearedWaveNumber : int) : bool
        + Pick(index : int) : void
    }
}

' ============================================================
' WAVE SET SPAWNING SYSTEM
' ============================================================
package "Wave Set Spawner System" {
    class EnemySpawner <<MonoBehaviour>> {
        + waves : Wave[]
        + spawnPoints : Transform[]
        + spawnRadius : float = 1.5f
        + delayBetweenWaves : float = 5.0f
        + waitForWaveClear : bool = true
        + offerUpgradesBetweenWaves : bool = true
        + loopWaves : bool = false
        + loopDifficultyMultiplier : float = 1.2f
        - RunSpawner() : IEnumerator
        - SpawnSet(set : WaveSpawnSet, loopScale : float) : IEnumerator
        - SpawnEnemy(prefab : GameObject, upgrades : List<EnemyUpgrade>) : EnemyBase
        + OnEnemyDied() : void
    }

    class Wave <<Serializable>> {
        + waveName : string
        + spawnSets : WaveSpawnSet[]
        + waveWideUpgrades : List<EnemyUpgrade>
    }

    class WaveSpawnSet <<Serializable>> {
        + setName : string
        + enemyPrefab : GameObject
        + enemyCount : int = 3
        + spawnInterval : float = 0.8f
        + delayAfterSet : float = 1.5f
        + setUpgrades : List<EnemyUpgrade>
    }

    class SpawnerDeathNotifier <<MonoBehaviour>> {
        - spawner : EnemySpawner
        + Init(spawner : EnemySpawner) : void
        - OnDestroy() : void
    }
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' Interfaces
IDamageable <|.. EnemyHealth
IDamageable <|.. EnemyBase
IAlertable <|.. Enemy_Range

' Enemy Inheritance
EnemyBase <|-- Enemy_Range
EnemyBase <|-- Enemy_Close
Enemy_Range <|-- Enemy_EliteShielder

' Enemy Composition (Stats, Health, Movement, Abilities)
EnemyBase *-- "1" EnemyStats : has >
EnemyBase *-- "1" EnemyHealth : has >
EnemyBase *-- "1" EnemyMovement : has >
EnemyBase o-- "0..*" EnemyAbility : composed of >
EnemyStats --> "1" EnemyStatsSO : reads defaults >
EnemyHealth --> "1" EnemyStats : reads MaxHp/CoinReward >
EnemyMovement --> "1" EnemyStats : reads MoveSpeed/RoamSpeed >
Enemy_Range *-- "0..1" EnemyFOV : uses >

' Ability Inheritance
EnemyAbility <|-- RangedBurstAbility
EnemyAbility <|-- CoverPeekAbility
EnemyAbility <|-- MeleeAttackAbility
EnemyAbility <|-- TeamAlertAbility
EnemyAbility <|-- RiotShieldAbility

' Ability Associations
RangedBurstAbility ..> EnemyBullet : instantiates >
CoverPeekAbility --> "0..1" CoverPoint : claims/releases >

' Upgrade Inheritance
UpgradeBase <|-- EnemyUpgrade
UpgradeBase <|-- PlayerUpgrade

EnemyUpgrade <|-- EnemyHealthUpgrade
EnemyUpgrade <|-- EnemySpeedUpgrade
EnemyUpgrade <|-- EnemyBurstFireUpgrade
EnemyUpgrade <|-- EnemyShieldUpgrade

PlayerUpgrade <|-- Upg_dmg
PlayerUpgrade <|-- Upg_ricochet
PlayerUpgrade <|-- FireRateUpgrade
PlayerUpgrade <|-- WalkSpeedUpgrade
PlayerUpgrade <|-- MagazineCapacityUpgrade
PlayerUpgrade <|-- HomingRicochetUpgrade

' Upgrade Associations
EnemyBase o-- "0..*" EnemyUpgrade : upgraded by >
UpgradeManager o-- "1..*" PlayerUpgrade : rolls & applies >
EnemySpawner ..> UpgradeManager : triggers after wave clear >

' Wave Set Spawning Composition
EnemySpawner *-- "1..*" Wave : manages >
Wave *-- "1..*" WaveSpawnSet : spawns in sets >
Wave o-- "0..*" EnemyUpgrade : applies to wave >
WaveSpawnSet o-- "0..*" EnemyUpgrade : applies to set >
EnemySpawner ..> EnemyBase : spawns & configures >
EnemySpawner ..> SpawnerDeathNotifier : attaches >

@enduml

